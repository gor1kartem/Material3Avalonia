<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MaterialTheme.MaterialTheme">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Accents/ColorPalette.axaml"></ResourceInclude>
                <ResourceInclude Source="Resources/StateLayer.axaml"></ResourceInclude>
                <ResourceInclude Source="Animations/Easings.axaml"></ResourceInclude>
                <ResourceInclude Source="Typography/FontSize.axaml"></ResourceInclude>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <FontFamily x:Key="MaterialSymbols" >avares://MaterialTheme/Resources#Material Symbols Rounded</FontFamily>
        <FontFamily x:Key="GoogleSansFlex" >avares://MaterialTheme/Resources#Google Sans Flex</FontFamily>
        <FontFamily x:Key="Roboto" >avares://MaterialTheme/Resources#Roboto</FontFamily>
    </Styles.Resources>
    
    <StyleInclude Source="MaterialControls.axaml"></StyleInclude>
    <StyleInclude Source="Styles/NavigationPage.axaml"></StyleInclude>
</Styles>
