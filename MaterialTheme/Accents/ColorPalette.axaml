<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="Primary">#6750A4</Color>
            <Color x:Key="OnPrimary">#FFFFFF</Color>
            <Color x:Key="SurfaceContainer">#F3EDF7</Color>
            <Color x:Key="SurfaceContainerLow">#F7F2FA</Color>
            <Color x:Key="SurfaceContainerHighest">#E6E0E9</Color>
            <Color x:Key="SurfaceTintColor">#6750A4</Color>
            <Color x:Key="SecondaryContainer">#E8DEF8</Color>
            <Color x:Key="OnSecondaryContainer">#4A4458</Color>
            <Color x:Key="Surface">#FEF7FF</Color>
            <Color x:Key="OnSurface">#1D1B20</Color>
            <Color x:Key="Outline">#79747E</Color>
            <Color x:Key="OutlineVariant">#CAC4D0</Color>
            <Color x:Key="PrimaryContainer">#EADDFF</Color>
            <Color x:Key="OnSurfaceVariant">#49454F</Color>
            <Color x:Key="Shadow">#000000</Color>
            <Color x:Key="Secondary">#625B71</Color>
            <Color x:Key="OnSecondary">#FFFFFF</Color>
            <Color x:Key="SurfaceContainerHigh">#ECE6F0</Color>
            <Color x:Key="Error"> #B3261E</Color>
            <Color x:Key="OnError"> #FFFFFF</Color>
            <Color x:Key="ErrorContainer">  #F9DEDC </Color>
            <Color x:Key="OnErrorContainer">   #8C1D18  </Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="Primary">#D0BCFF</Color>
            <Color x:Key="OnPrimary">#381E72</Color>
            <Color x:Key="SurfaceContainer">#211F26</Color>
            <Color x:Key="SurfaceContainerLow">#1D1B20</Color>
            <Color x:Key="SurfaceContainerHighest">#36343B</Color>
            <Color x:Key="SurfaceTintColor">#D0BCFF</Color>
            <Color x:Key="SecondaryContainer">#4A4458</Color>
            <Color x:Key="OnSecondaryContainer">#E8DEF8</Color>
            <Color x:Key="Surface">#141218</Color>
            <Color x:Key="OnSurface">#E6E0E9</Color>
            <Color x:Key="Outline">#938F99</Color>
            <Color x:Key="OutlineVariant">#49454F</Color>
            <Color x:Key="PrimaryContainer">#4F378B</Color>
            <Color x:Key="OnSurfaceVariant">#CAC4D0</Color>
            <Color x:Key="Shadow">#000000</Color>
            <Color x:Key="Secondary">#CCC2DC</Color>
            <Color x:Key="OnSecondary">#332D41</Color>
            <Color x:Key="SurfaceContainerHigh">#2B2930</Color>
            <Color x:Key="Error">  #F2B8B5 </Color>
            <Color x:Key="OnError"> #601410 </Color>
            <Color x:Key="ErrorContainer">   #8C1D18  </Color>
            <Color x:Key="OnErrorContainer">   #F9DEDC   </Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
