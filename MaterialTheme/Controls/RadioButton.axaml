<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel Width="200" Height="200">
            <RadioButton Content="Hello World"></RadioButton>
            <RadioButton Content="Sigma"></RadioButton>
            <RadioButton IsEnabled="False"></RadioButton>
            <RadioButton IsEnabled="False" IsChecked="True"></RadioButton>
        </StackPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="RadioButton">
                <Border Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="20, *">
                        <Grid Height="32" VerticalAlignment="Top" >
                            <Ellipse Width="20" Height="20" Fill="Transparent" Stroke="{DynamicResource OnSurfaceVariant}" StrokeThickness="2" Name="OuterEllipse" UseLayoutRounding="False"></Ellipse>
                            <Ellipse Width="0" Height="0" Fill="{DynamicResource Primary}" Name="InnerEllipse" UseLayoutRounding="False">
                                <Ellipse.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="{DynamicResource StandardEasing}">
                                        </DoubleTransition>
                                        <DoubleTransition Property="Height" Duration="0:0:0.2" Easing="{DynamicResource StandardEasing}">
                                        </DoubleTransition>
                                    </Transitions>
                                </Ellipse.Transitions>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter Content="{TemplateBinding Content}" 
                                          Grid.Column="1" 
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" ContentTemplate="{TemplateBinding ContentTemplate}" RecognizesAccessKey="True"></ContentPresenter>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Ellipse#InnerEllipse">
            <Setter Property="Width" Value="10"></Setter>
            <Setter Property="Height" Value="10"></Setter>
        </Style>
        <Style Selector="^:checked /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource Primary}"></Setter>
        </Style>
        <Style Selector="^:disabled /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource OnSurface}"></Setter>
            <Setter Property="Opacity" Value="0.38"></Setter>
        </Style>
        <Style Selector="^:disabled /template/ Ellipse#InnerEllipse">
            <Setter Property="Fill" Value="{DynamicResource OnSurface}"></Setter>
            <Setter Property="Opacity" Value="0.38"></Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>