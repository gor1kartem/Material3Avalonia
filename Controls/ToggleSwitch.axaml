<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<!-- Constants used in the template -->
<Design.PreviewWith>
  <StackPanel Width="1000">
    <ToggleSwitch CornerRadius="202" ></ToggleSwitch>
    <ToggleSwitch IsEnabled="False"></ToggleSwitch>
    <ToggleSwitch IsEnabled="False" IsChecked="True"></ToggleSwitch>
    <Button Content="Download"></Button>
  </StackPanel>
</Design.PreviewWith>
  <Thickness x:Key="ToggleSwitchTopHeaderMargin">0,0,0,6</Thickness>
  <GridLength x:Key="ToggleSwitchPreContentMargin">0</GridLength>   <!-- Adjusted for closer content -->
  <GridLength x:Key="ToggleSwitchPostContentMargin">0</GridLength>  <!-- Adjusted for closer content -->
  <x:Double x:Key="ToggleSwitchThemeMinWidth">40</x:Double>       <!-- Set MinWidth based on track size -->
  <Thickness x:Key="ToggleSwitchOuterBorderStrokeThickness">1</Thickness>
  <Thickness x:Key="ToggleSwitchOnStrokeThickness">0</Thickness> <!-- No visible border on the purple 'On' state -->

  <!-- ToggleSwitch Control Theme -->
  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
    <!-- Default Properties -->
    <Setter Property="Foreground" Value="#212121" /> <!-- Default Text Color -->
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" /> <!-- Grid background is transparent -->
    <Setter Property="BorderThickness" Value="0"/> <!-- Control itself has no border -->
    <Setter Property="Padding" Value="0"/> <!-- Control itself has no padding -->

    <!-- Control Template -->
    <Setter Property="Template">
      <ControlTemplate TargetType="ToggleSwitch">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}">
          <Grid x:Name="PART_LayoutRoot" ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">

            <!-- Optional Header Content -->
            <ContentPresenter x:Name="PART_HeaderContentPresenter"
                              Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Top"
                              Margin="{StaticResource ToggleSwitchTopHeaderMargin}"
                              RecognizesAccessKey="True" />

            <!-- Switch Container Grid -->
            <Grid x:Name="SwitchAreaGrid"
                  Grid.Row="1" Grid.Column="0"
                  MinWidth="{StaticResource ToggleSwitchThemeMinWidth}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">

              <Border x:Name="OuterBorder"
                      Width="52" Height="32"
                      Background="{DynamicResource SurfaceContainerHighest}"           
                      BorderBrush="{DynamicResource Outline}"           
                      BorderThickness="2"
                      CornerRadius="20"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"/>

              <!-- On State Visual (initially hidden by opacity) -->
              <Border x:Name="SwitchKnobBounds"
                      Width="52" Height="32"
                      Background="{DynamicResource Primary}"          
                      BorderBrush="{DynamicResource Primary}"           
                      BorderThickness="{StaticResource ToggleSwitchOnStrokeThickness}"
                      CornerRadius="20"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Opacity="0"/>

              <Grid x:Name="PART_SwitchKnob" HorizontalAlignment="Left"></Grid>
              <!-- Moving Knob Canvas -->
                <!-- Grid containing both knob versions for opacity swap -->
                <Canvas x:Name="PART_MovingKnobs"  Width="52" Height="32"  ClipToBounds="False">

                  <Ellipse x:Name="SwitchKnobOff"
                           Fill="{DynamicResource Outline}"              
                           Width="16" Height="16"     
                           HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Top="8" Canvas.Left="8">
                    <Ellipse.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Canvas.Left" Duration="0:0:0.07" Easing="QuarticEaseOut"></DoubleTransition>
                        <DoubleTransition Property="Width" Duration="0:0:0.07" Easing="{DynamicResource StandardEasing}">
                        </DoubleTransition>
                        <DoubleTransition Property="Height" Duration="0:0:0.07" Easing="{DynamicResource StandardEasing}">
                        </DoubleTransition>
                        <DoubleTransition Property="Canvas.Top" Duration="0:0:0.07" Easing="QuarticEaseOut"></DoubleTransition>
                      </Transitions>
                    </Ellipse.Transitions>
                  </Ellipse>
                </Canvas>
            </Grid>

            <!-- On/Off Content Labels -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
              <ContentPresenter x:Name="PART_OffContentPresenter"
                                Content="{TemplateBinding OffContent}"
                                ContentTemplate="{TemplateBinding OffContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Opacity="1"/>
              <ContentPresenter x:Name="PART_OnContentPresenter"
                                Content="{TemplateBinding OnContent}"
                                ContentTemplate="{TemplateBinding OnContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Opacity="0"/>
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Style Changes Based on State -->

    <!-- Header Visibility -->
    <Style Selector="^ /template/ ContentPresenter#PART_HeaderContentPresenter:empty">
      <Setter Property="Margin" Value="0" />
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_HeaderContentPresenter:not(:empty)">
       <Setter Property="Margin" Value="{StaticResource ToggleSwitchTopHeaderMargin}" />
       <Setter Property="IsVisible" Value="True"/>
    </Style>

    
     <Style Selector="^:pointerover /template/ Ellipse#SwitchKnobOff">
       <Setter Property="Fill" Value="{DynamicResource OnSurfaceVariant}"></Setter>
    </Style>
    
     <Style Selector="^:pressed /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30"></Setter>
      <Setter Property="Canvas.Top" Value="1"></Setter>
      <Setter Property="Canvas.Left" Value="1"></Setter>
    </Style>

    <!-- Disabled State -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="#A0A0A0" /> <!-- Disabled Text Color -->
    </Style>
    <Style Selector="^:disabled /template/ Border#OuterBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource OnSurface}" /> <!-- Light Gray Border -->
      <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighest}"></Setter>
      <Setter Property="Opacity" Value="0.12"></Setter>
    </Style>
     <Style Selector="^:disabled /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Fill" Value="{DynamicResource OnSurface}" />
      <Setter Property="Opacity" Value="0.38"></Setter><!-- Light Gray Knob -->
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter">
        <Setter Property="Foreground" Value="#A0A0A0" />
    </Style>

    <!-- Checked State (On) -->
    <Style Selector="^:checked /template/ Border#SwitchKnobBounds">
      <Setter Property="Opacity" Value="1" /> <!-- Show On state visual -->
    </Style>
    <Style Selector="^:checked /template/ Ellipse#SwitchKnobOff" >
      <Setter Property="Canvas.Left" Value="24" /> <!-- Show On state knob -->
      <Setter Property="Canvas.Top" Value="4" /> <!-- Show On state knob -->
      <Setter Property="Width" Value="24"></Setter>
      <Setter Property="Height" Value="24"></Setter>
      <Setter Property="Fill" Value="{DynamicResource OnPrimary}"></Setter>
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_OffContentPresenter">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_OnContentPresenter">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Note: The ToggleSwitch code-behind handles moving PART_SwitchKnob Canvas.Left -->

    <!-- Unchecked State (Off) - Default visual state, opacities handled above -->
    <!-- No specific styles needed here as defaults + checked styles cover it -->
    <Style Selector="^:checked:pressed /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28"></Setter>
      <Setter Property="Canvas.Left" Value="23" ></Setter>
      <Setter Property="Canvas.Top" Value="2"></Setter>
    </Style>
    <Style Selector="^:checked:pointerover /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Fill" Value="{DynamicResource PrimaryContainer}"></Setter>
    </Style>
    <Style Selector="^:checked:disabled /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{DynamicResource OnSurface}" /> <!-- Desaturated Purple -->
      <Setter Property="BorderBrush" Value="{DynamicResource OnSurface}" />
      <Setter Property="Opacity" Value="0.12"></Setter>
    </Style>
    <Style Selector="^:checked:disabled /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Opacity" Value="1"></Setter>
      <Setter Property="Fill" Value="{DynamicResource Surface}"></Setter>
    </Style>
  </ControlTheme>
</ResourceDictionary>